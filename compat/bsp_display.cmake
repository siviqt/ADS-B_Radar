# Replace one BSP source without changing managed components or the shared SDK.
idf_component_get_property(_adsb_bsp_dir badgeteam__badge-bsp COMPONENT_DIR)
idf_component_get_property(_adsb_bsp_lib badgeteam__badge-bsp COMPONENT_LIB)
set(_adsb_bsp_original "${_adsb_bsp_dir}/targets/tanmatsu/badge_bsp_display.c")
set(_adsb_bsp_patched "${CMAKE_CURRENT_LIST_DIR}/badge_bsp_display.c")
file(READ "${CMAKE_CURRENT_LIST_DIR}/upstream.json" _adsb_bsp_provenance)
string(JSON _adsb_bsp_expected GET "${_adsb_bsp_provenance}" upstream_sha256)
file(SHA256 "${_adsb_bsp_original}" _adsb_bsp_actual)
if(NOT _adsb_bsp_actual STREQUAL _adsb_bsp_expected)
    message(FATAL_ERROR "BSP display source changed; review the ADS-B initialization-error patch")
endif()

get_target_property(_adsb_bsp_sources ${_adsb_bsp_lib} SOURCES)
list(FIND _adsb_bsp_sources "${_adsb_bsp_original}" _adsb_bsp_index)
if(_adsb_bsp_index EQUAL -1)
    message(FATAL_ERROR "Cannot find the Tanmatsu BSP display source to replace")
endif()
list(REMOVE_ITEM _adsb_bsp_sources "${_adsb_bsp_original}")
list(APPEND _adsb_bsp_sources "${_adsb_bsp_patched}")
set_property(TARGET ${_adsb_bsp_lib} PROPERTY SOURCES "${_adsb_bsp_sources}")
target_include_directories(${_adsb_bsp_lib} PRIVATE "${_adsb_bsp_dir}/targets/tanmatsu")
message(STATUS "ADS-B: using the local BSP display initialization-error patch")
